<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>E‑Shop · premium store</title>
  <!-- Font Awesome 6 (free) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <!-- Google Font (Inter) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap" rel="stylesheet" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', sans-serif;
      background: #f6f9fc;
      color: #0b1a33;
      padding: 1.5rem 1.5rem 3rem;
    }
    .container {
      max-width: 1400px;
      margin: 0 auto;
    }
    /* ----- header / navbar ----- */
    .top-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      background: rgba(255,255,255,0.8);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 0.6rem 1.8rem;
      border-radius: 60px;
      box-shadow: 0 12px 40px -12px rgba(0,20,40,0.12);
      margin-bottom: 2.5rem;
      border: 1px solid rgba(255,255,255,0.5);
    }
    .logo {
      font-size: 1.7rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .logo i {
      -webkit-text-fill-color: #2563eb;
      margin-right: 6px;
    }
    .nav-links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem;
    }
    .nav-links button {
      background: transparent;
      border: none;
      padding: 0.5rem 1.1rem;
      font-weight: 500;
      border-radius: 40px;
      cursor: pointer;
      transition: 0.2s ease;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 8px;
      color: #1e293b;
    }
    .nav-links button i {
      font-size: 1rem;
      color: #475569;
    }
    .nav-links button:hover {
      background: #eef2ff;
      color: #2563eb;
    }
    .nav-links button:hover i {
      color: #2563eb;
    }
    .btn-primary {
      background: #2563eb !important;
      color: white !important;
      box-shadow: 0 4px 12px rgba(37,99,235,0.25);
    }
    .btn-primary i {
      color: white !important;
    }
    .btn-primary:hover {
      background: #1d4ed8 !important;
      box-shadow: 0 6px 16px rgba(37,99,235,0.35);
    }
    .cart-badge {
      background: #ef4444;
      color: white;
      border-radius: 40px;
      padding: 0.1rem 0.6rem;
      font-size: 0.75rem;
      font-weight: 700;
      margin-left: 4px;
      min-width: 20px;
      text-align: center;
    }
    .user-status {
      font-size: 0.85rem;
      background: #f1f5f9;
      padding: 0.3rem 1.2rem;
      border-radius: 40px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #1e293b;
      font-weight: 500;
    }
    .user-status i {
      color: #2563eb;
    }
    /* ----- product grid ----- */
    .section-title {
      font-size: 1.8rem;
      font-weight: 600;
      margin: 2rem 0 1.2rem;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title span {
      background: linear-gradient(135deg, #2563eb, #7c3aed);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .product-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 2rem;
      margin: 1.5rem 0 2rem;
    }
    .product-card {
      background: white;
      border-radius: 32px;
      padding: 1.5rem 1.2rem 1.5rem;
      box-shadow: 0 8px 28px -8px rgba(0,20,40,0.06);
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
      border: 1px solid rgba(226, 232, 240, 0.6);
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .product-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 48px -12px rgba(0,20,40,0.14);
      border-color: #bdd3ff;
    }
    .product-img {
      width: 100%;
      aspect-ratio: 1/1;
      background: linear-gradient(145deg, #f1f5f9, #e9eef3);
      border-radius: 28px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 3.2rem;
      color: #1e293b;
      margin-bottom: 0.8rem;
      transition: 0.2s;
    }
    .product-card:hover .product-img {
      background: linear-gradient(145deg, #eef2ff, #e0e8f5);
    }
    .product-title {
      font-weight: 600;
      font-size: 1.05rem;
      margin-bottom: 0.2rem;
      color: #0b1a33;
    }
    .product-price {
      font-weight: 700;
      font-size: 1.25rem;
      color: #2563eb;
      margin: 0.25rem 0 0.6rem;
    }
    .product-actions {
      display: flex;
      gap: 8px;
      margin-top: 0.4rem;
      flex-wrap: wrap;
    }
    .product-actions button {
      flex: 1;
      background: #f1f5f9;
      border: none;
      padding: 0.55rem 0;
      border-radius: 40px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      transition: 0.2s;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      color: #1e293b;
    }
    .product-actions .btn-add {
      background: #2563eb;
      color: white;
      box-shadow: 0 4px 10px rgba(37,99,235,0.2);
    }
    .product-actions .btn-add:hover {
      background: #1d4ed8;
      box-shadow: 0 6px 14px rgba(37,99,235,0.3);
    }
    .product-actions .btn-detail {
      background: #f1f5f9;
    }
    .product-actions .btn-detail:hover {
      background: #e2e8f0;
    }
    /* ----- panels (detail, cart, auth, orders) ----- */
    .panel {
      background: white;
      border-radius: 40px;
      padding: 2rem 2.2rem;
      margin: 2rem 0;
      box-shadow: 0 12px 40px -12px rgba(0,20,40,0.06);
      border: 1px solid rgba(226, 232, 240, 0.6);
      display: none;
      transition: 0.25s;
    }
    .panel.active {
      display: block;
      animation: fadeSlide 0.3s ease;
    }
    @keyframes fadeSlide {
      0% { opacity: 0; transform: translateY(10px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    .panel h2 {
      font-size: 1.6rem;
      font-weight: 600;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .panel h2 i {
      color: #2563eb;
    }
    /* detail row */
    .detail-row {
      display: flex;
      flex-wrap: wrap;
      gap: 2.5rem;
      align-items: center;
    }
    .detail-image {
      flex: 1 1 200px;
      background: linear-gradient(145deg, #f1f5f9, #e9eef3);
      border-radius: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 5.5rem;
      min-height: 220px;
      color: #1e293b;
    }
    .detail-info {
      flex: 2 1 300px;
    }
    .detail-info h2 {
      font-size: 2rem;
      margin-bottom: 0.2rem;
    }
    .detail-info .price {
      font-size: 2rem;
      font-weight: 700;
      color: #2563eb;
      margin: 0.6rem 0;
    }
    .detail-info p {
      color: #475569;
      line-height: 1.7;
      margin: 0.8rem 0 1.2rem;
      max-width: 500px;
    }
    .detail-info .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0.6rem 1.6rem;
      border-radius: 60px;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: 0.2s;
      font-size: 0.95rem;
      background: #f1f5f9;
      color: #1e293b;
    }
    .btn-primary-solid {
      background: #2563eb;
      color: white;
      box-shadow: 0 4px 12px rgba(37,99,235,0.25);
    }
    .btn-primary-solid:hover {
      background: #1d4ed8;
      box-shadow: 0 6px 18px rgba(37,99,235,0.35);
    }
    .btn-outline {
      background: transparent;
      border: 1.5px solid #d1d9e6;
    }
    .btn-outline:hover {
      background: #f1f5f9;
    }
    .btn-success {
      background: #16a34a;
      color: white;
      box-shadow: 0 4px 12px rgba(22,163,74,0.25);
    }
    .btn-success:hover {
      background: #15803d;
      box-shadow: 0 6px 16px rgba(22,163,74,0.35);
    }
    .btn-danger {
      background: #ef4444;
      color: white;
    }
    .btn-danger:hover {
      background: #dc2626;
    }
    .btn-warning {
      background: #f59e0b;
      color: white;
    }
    .btn-warning:hover {
      background: #d97706;
    }
    /* cart */
    .cart-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.9rem 0;
      border-bottom: 1px solid #f1f5f9;
    }
    .cart-item:last-child {
      border-bottom: none;
    }
    .cart-item span {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .cart-item .item-qty {
      background: #f1f5f9;
      padding: 0.1rem 0.6rem;
      border-radius: 30px;
      font-weight: 600;
    }
    .cart-summary {
      margin-top: 1.8rem;
      display: flex;
      justify-content: space-between;
      font-weight: 700;
      font-size: 1.3rem;
      border-top: 2px dashed #e2e8f0;
      padding-top: 1.2rem;
    }
    /* auth */
    .auth-form {
      max-width: 400px;
    }
    .auth-form input {
      width: 100%;
      padding: 0.8rem 1.2rem;
      margin: 0.5rem 0;
      border: 1.5px solid #e2e8f0;
      border-radius: 60px;
      font-size: 0.95rem;
      transition: 0.2s;
      background: #fafcff;
    }
    .auth-form input:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
    }
    .auth-form button {
      width: 100%;
      padding: 0.8rem;
      background: #2563eb;
      border: none;
      color: white;
      font-weight: 600;
      border-radius: 60px;
      margin-top: 0.8rem;
      cursor: pointer;
      font-size: 1rem;
      box-shadow: 0 4px 12px rgba(37,99,235,0.25);
      transition: 0.2s;
    }
    .auth-form button:hover {
      background: #1d4ed8;
      box-shadow: 0 6px 18px rgba(37,99,235,0.35);
    }
    .toggle-auth {
      margin-top: 1.2rem;
      font-size: 0.95rem;
    }
    .toggle-auth span {
      color: #2563eb;
      cursor: pointer;
      font-weight: 600;
    }
    .toggle-auth span:hover {
      text-decoration: underline;
    }
    /* orders */
    .order-item {
      background: #f8fafc;
      padding: 1.2rem 1.5rem;
      border-radius: 24px;
      margin-bottom: 1rem;
      border: 1px solid #eef2f6;
      transition: 0.2s;
    }
    .order-item:hover {
      border-color: #cbd5e1;
    }
    .order-item .order-meta {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
    }
    .order-item .order-actions {
      display: flex;
      gap: 0.6rem;
      margin-top: 0.6rem;
      flex-wrap: wrap;
    }
    .order-item .order-actions .btn {
      padding: 0.3rem 1.2rem;
      font-size: 0.8rem;
    }
    .order-item.cancelled {
      opacity: 0.6;
      background: #f1f5f9;
      border-color: #e2e8f0;
    }
    .order-item.cancelled .order-meta strong {
      text-decoration: line-through;
    }
    .badge-status {
      display: inline-block;
      padding: 0.15rem 0.8rem;
      border-radius: 30px;
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }
    .badge-status.active {
      background: #dbeafe;
      color: #1d4ed8;
    }
    .badge-status.cancelled {
      background: #fee2e2;
      color: #dc2626;
    }
    .text-muted { color: #64748b; }
    .mt-2 { margin-top: 1.5rem; }
    .flex { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
    .hide { display: none !important; }
    .gap-1 { gap: 0.8rem; }
    .badge {
      background: #dbeafe;
      color: #1d4ed8;
      padding: 0.15rem 0.8rem;
      border-radius: 30px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    /* responsive */
    @media (max-width: 640px) {
      .top-bar { padding: 0.6rem 1rem; }
      .nav-links button { padding: 0.4rem 0.7rem; font-size: 0.85rem; }
      .panel { padding: 1.5rem; }
    }
  </style>
</head>
<body>
<div class="container" id="app">
  <!-- header -->
  <header class="top-bar">
    <div class="logo"><i class="fas fa-store-alt"></i> E‑Shop</div>
    <div class="nav-links">
      <button id="homeBtn"><i class="fas fa-home"></i> Home</button>
      <button id="cartBtn"><i class="fas fa-shopping-cart"></i> Cart <span id="cartCount" class="cart-badge">0</span></button>
      <button id="ordersBtn"><i class="fas fa-box"></i> Orders</button>
      <button id="authBtn"><i class="fas fa-user-circle"></i> <span id="authLabel">Login</span></button>
      <button id="logoutBtn" class="hide"><i class="fas fa-sign-out-alt"></i> Logout</button>
    </div>
  </header>

  <!-- user status -->
  <div class="user-status"><i class="fas fa-user-circle"></i> <span id="userName">Guest</span></div>

  <!-- product grid -->
  <div class="section-title"><span>✦ New arrivals</span></div>
  <div id="productGrid" class="product-grid"></div>

  <!-- detail panel -->
  <div id="detailPanel" class="panel">
    <div class="detail-row">
      <div class="detail-image" id="detailImage">📦</div>
      <div class="detail-info">
        <h2 id="detailTitle">Product</h2>
        <div class="price" id="detailPrice">$0.00</div>
        <p id="detailDesc">Description</p>
        <div class="btn-group">
          <button class="btn btn-primary-solid" id="detailAddBtn"><i class="fas fa-cart-plus"></i> Add to cart</button>
          <button class="btn btn-outline" id="detailCloseBtn">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- cart panel -->
  <div id="cartPanel" class="panel">
    <h2><i class="fas fa-shopping-cart"></i> Your cart</h2>
    <div id="cartItems"></div>
    <div class="cart-summary"><span>Total</span> <span id="cartTotal">$0.00</span></div>
    <button class="btn btn-success mt-2" id="checkoutBtn"><i class="fas fa-credit-card"></i> Proceed to checkout</button>
  </div>

  <!-- auth panel -->
  <div id="authPanel" class="panel">
    <h2 id="authTitle"><i class="fas fa-user-lock"></i> Login</h2>
    <div class="auth-form">
      <input type="text" id="authEmail" placeholder="Email address" value="demo@shop.com" />
      <input type="password" id="authPassword" placeholder="Password" value="123456" />
      <button id="authSubmitBtn">Sign in</button>
      <div class="toggle-auth"> <span id="authToggle">Create an account</span></div>
      <div id="authMessage" class="text-muted mt-2"></div>
    </div>
  </div>

  <!-- orders panel -->
  <div id="orderPanel" class="panel">
    <h2><i class="fas fa-box"></i> Your orders</h2>
    <div id="orderList"><p class="text-muted">No orders yet.</p></div>
  </div>
</div>

<script>
  (function() {
    // ---------- 12 premium products ----------
    const products = [
      { id: 1, name: 'Studio Wireless Headphones', price: 49.99, desc: 'Active noise cancelling, 30h battery, Hi‑Res audio.', icon: '🎧' },
      { id: 2, name: 'Fusion Smart Watch', price: 89.99, desc: 'Heart rate, SpO2, GPS, AMOLED always‑on display.', icon: '⌚' },
      { id: 3, name: 'Ultra USB‑C Hub', price: 29.99, desc: '7‑in‑1, 4K@60Hz, 100W PD, SD/microSD.', icon: '🔌' },
      { id: 4, name: 'Mech Pro Keyboard', price: 79.99, desc: 'Hot‑swap, RGB, PBT keycaps, tactile switches.', icon: '⌨️' },
      { id: 5, name: 'Boom Bluetooth Speaker', price: 39.99, desc: '360° sound, IP67, 14h playtime, stereo pair.', icon: '🔊' },
      { id: 6, name: 'Action 4K Camera', price: 129.99, desc: 'Waterproof 10m, image stabilization, dual screens.', icon: '📷' },
      { id: 7, name: 'Aero Laptop Stand', price: 24.99, desc: 'Aluminum, foldable, ergonomic, heat dissipation.', icon: '💻' },
      { id: 8, name: 'Silent Wireless Mouse', price: 19.99, desc: '1600 DPI, silent clicks, ergonomic shape.', icon: '🖱️' },
      { id: 9, name: 'Gimbal Pro', price: 89.99, desc: '3‑axis stabilizer, face tracking, foldable, app control.', icon: '📱' },
      { id: 10, name: 'Aura Desk Lamp', price: 34.99, desc: 'Touch dimmer, USB‑C charging, flexible neck, 5 modes.', icon: '💡' },
      { id: 11, name: 'Portable SSD 1TB', price: 149.99, desc: 'USB 3.2 Gen 2, 1050 MB/s, shockproof, compact.', icon: '💾' },
      { id: 12, name: 'Smart Home Hub', price: 59.99, desc: 'Voice control, Zigbee, Wi‑Fi, multi‑room, Thread ready.', icon: '🏠' },
    ];

    // ---------- state ----------
    let users = [
      { id: 1, email: 'demo@shop.com', password: '123456', name: 'Demo User' },
    ];
    let orders = [];
    let cart = [];
    let currentUser = null;
    let currentDetailProduct = null;
    let authMode = 'login'; // 'login' | 'register'

    // ---------- DOM refs ----------
    const grid = document.getElementById('productGrid');
    const detailPanel = document.getElementById('detailPanel');
    const detailTitle = document.getElementById('detailTitle');
    const detailPrice = document.getElementById('detailPrice');
    const detailDesc = document.getElementById('detailDesc');
    const detailImage = document.getElementById('detailImage');
    const detailAddBtn = document.getElementById('detailAddBtn');
    const detailCloseBtn = document.getElementById('detailCloseBtn');
    const cartPanel = document.getElementById('cartPanel');
    const cartItems = document.getElementById('cartItems');
    const cartTotal = document.getElementById('cartTotal');
    const cartCount = document.getElementById('cartCount');
    const authPanel = document.getElementById('authPanel');
    const authTitle = document.getElementById('authTitle');
    const authEmail = document.getElementById('authEmail');
    const authPassword = document.getElementById('authPassword');
    const authSubmitBtn = document.getElementById('authSubmitBtn');
    const authToggle = document.getElementById('authToggle');
    const authMessage = document.getElementById('authMessage');
    const orderPanel = document.getElementById('orderPanel');
    const orderList = document.getElementById('orderList');
    const userName = document.getElementById('userName');
    const authLabel = document.getElementById('authLabel');
    const logoutBtn = document.getElementById('logoutBtn');
    const checkoutBtn = document.getElementById('checkoutBtn');

    // ---------- render functions ----------
    function renderProducts() {
      grid.innerHTML = products.map(p => `
        <div class="product-card" data-id="${p.id}">
          <div class="product-img">${p.icon}</div>
          <div class="product-title">${p.name}</div>
          <div class="product-price">$${p.price.toFixed(2)}</div>
          <div class="product-actions">
            <button class="btn-add" data-id="${p.id}"><i class="fas fa-cart-plus"></i> Add</button>
            <button class="btn-detail" data-id="${p.id}"><i class="fas fa-eye"></i> Detail</button>
          </div>
        </div>
      `).join('');
      document.querySelectorAll('.btn-add').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = Number(btn.dataset.id);
          addToCart(id);
        });
      });
      document.querySelectorAll('.btn-detail').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const id = Number(btn.dataset.id);
          showDetail(id);
        });
      });
    }

    function addToCart(productId) {
      const product = products.find(p => p.id === productId);
      if (!product) return;
      const existing = cart.find(item => item.id === productId);
      if (existing) existing.qty += 1;
      else cart.push({ ...product, qty: 1 });
      updateCartUI();
      const btn = document.querySelector(`.btn-add[data-id="${productId}"]`);
      if (btn) { btn.style.transform = 'scale(0.94)'; setTimeout(() => btn.style.transform = '', 200); }
    }

    function removeFromCart(productId) {
      cart = cart.filter(item => item.id !== productId);
      updateCartUI();
    }

    function updateCartUI() {
      const totalItems = cart.reduce((sum, item) => sum + item.qty, 0);
      cartCount.textContent = totalItems;
      const totalPrice = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
      cartTotal.textContent = `$${totalPrice.toFixed(2)}`;
      if (cart.length === 0) {
        cartItems.innerHTML = `<p class="text-muted" style="padding: 1rem 0;">Your cart is empty.</p>`;
      } else {
        cartItems.innerHTML = cart.map(item => `
          <div class="cart-item">
            <span>${item.icon} ${item.name} <span class="item-qty">×${item.qty}</span></span>
            <span>$${(item.price * item.qty).toFixed(2)} 
              <button class="btn btn-outline" style="padding:0.2rem 0.8rem; font-size:0.8rem; margin-left:8px;" data-remove="${item.id}"><i class="fas fa-trash-alt"></i></button>
            </span>
          </div>
        `).join('');
        document.querySelectorAll('[data-remove]').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const id = Number(btn.dataset.remove);
            removeFromCart(id);
          });
        });
      }
    }

    function showDetail(id) {
      const product = products.find(p => p.id === id);
      if (!product) return;
      currentDetailProduct = product;
      detailTitle.textContent = product.name;
      detailPrice.textContent = `$${product.price.toFixed(2)}`;
      detailDesc.textContent = product.desc;
      detailImage.textContent = product.icon;
      detailPanel.classList.add('active');
      detailPanel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      cartPanel.classList.remove('active');
      authPanel.classList.remove('active');
      orderPanel.classList.remove('active');
    }

    function closeDetail() { detailPanel.classList.remove('active'); }

    function renderOrders() {
      if (orders.length === 0) {
        orderList.innerHTML = `<p class="text-muted">No orders yet.</p>`;
        return;
      }
      orderList.innerHTML = orders.map((order, idx) => {
        const isCancelled = order.cancelled || false;
        return `
          <div class="order-item ${isCancelled ? 'cancelled' : ''}">
            <div class="order-meta">
              <div>
                <strong>Order #${idx+1}</strong>
                <span class="badge-status ${isCancelled ? 'cancelled' : 'active'}">${isCancelled ? 'Cancelled' : 'Active'}</span>
              </div>
              <span class="badge">${new Date(order.date).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' })}</span>
            </div>
            <div style="margin: 0.4rem 0;">${order.items.map(i => `${i.name} × ${i.qty}`).join(' • ')}</div>
            <div><strong>Total: $${order.total.toFixed(2)}</strong></div>
            ${!isCancelled ? `
              <div class="order-actions">
                <button class="btn btn-danger cancel-order" data-index="${idx}"><i class="fas fa-times-circle"></i> Cancel Order</button>
              </div>
            ` : `
              <div class="order-actions">
                <span class="text-muted" style="font-size:0.85rem;"><i class="fas fa-ban"></i> Order cancelled</span>
              </div>
            `}
          </div>
        `;
      }).join('');

      // Attach cancel event listeners
      document.querySelectorAll('.cancel-order').forEach(btn => {
        btn.addEventListener('click', function(e) {
          const index = Number(this.dataset.index);
          cancelOrder(index);
        });
      });
    }

    // ---------- Cancel order function ----------
    function cancelOrder(index) {
      if (index < 0 || index >= orders.length) return;
      const order = orders[index];
      if (order.cancelled) {
        alert('This order is already cancelled.');
        return;
      }
      // Confirm cancellation
      if (confirm(`Are you sure you want to cancel Order #${index+1}?`)) {
        order.cancelled = true;
        renderOrders();
        // Optional: notify user
        alert(`Order #${index+1} has been cancelled.`);
      }
    }

    function placeOrder() {
      if (cart.length === 0) { alert('Your cart is empty.'); return; }
      if (!currentUser) { alert('Please login to place an order.'); return; }
      const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);
      const order = {
        userId: currentUser.id,
        items: cart.map(item => ({ id: item.id, name: item.name, qty: item.qty, price: item.price })),
        total: total,
        date: new Date().toISOString(),
        cancelled: false,  // new flag
      };
      orders.push(order);
      cart = [];
      updateCartUI();
      renderOrders();
      orderPanel.classList.add('active');
      cartPanel.classList.remove('active');
      detailPanel.classList.remove('active');
      alert('✅ Order placed successfully!');
    }

    // ---------- auth ----------
    function updateAuthUI() {
      if (currentUser) {
        userName.textContent = currentUser.name;
        authLabel.textContent = 'Profile';
        logoutBtn.classList.remove('hide');
        authPanel.classList.remove('active');
      } else {
        userName.textContent = 'Guest';
        authLabel.textContent = 'Login';
        logoutBtn.classList.add('hide');
      }
    }

    function handleAuth() {
      const email = authEmail.value.trim();
      const password = authPassword.value.trim();
      if (!email || !password) { authMessage.textContent = 'Please fill in all fields.'; return; }
      if (authMode === 'login') {
        const user = users.find(u => u.email === email && u.password === password);
        if (user) {
          currentUser = user;
          authMessage.textContent = `Welcome back, ${user.name}!`;
          updateAuthUI();
          authPanel.classList.remove('active');
          cartPanel.classList.remove('active');
          detailPanel.classList.remove('active');
          orderPanel.classList.remove('active');
        } else {
          authMessage.textContent = 'Invalid email or password.';
        }
      } else {
        if (users.find(u => u.email === email)) { authMessage.textContent = 'Email already exists.'; return; }
        const newUser = { id: users.length + 1, email, password, name: email.split('@')[0] || 'User' };
        users.push(newUser);
        currentUser = newUser;
        authMessage.textContent = `Account created! Welcome ${newUser.name}.`;
        updateAuthUI();
        authPanel.classList.remove('active');
        cartPanel.classList.remove('active');
        detailPanel.classList.remove('active');
        orderPanel.classList.remove('active');
      }
    }

    // ---------- navigation ----------
    function showHome() {
      detailPanel.classList.remove('active');
      cartPanel.classList.remove('active');
      authPanel.classList.remove('active');
      orderPanel.classList.remove('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function showCart() {
      detailPanel.classList.remove('active');
      authPanel.classList.remove('active');
      orderPanel.classList.remove('active');
      cartPanel.classList.toggle('active');
      if (cartPanel.classList.contains('active')) updateCartUI();
    }
    function showOrders() {
      detailPanel.classList.remove('active');
      cartPanel.classList.remove('active');
      authPanel.classList.remove('active');
      orderPanel.classList.toggle('active');
      if (orderPanel.classList.contains('active')) renderOrders();
    }
    function showAuth() {
      detailPanel.classList.remove('active');
      cartPanel.classList.remove('active');
      orderPanel.classList.remove('active');
      authPanel.classList.toggle('active');
      if (authPanel.classList.contains('active')) {
        authMessage.textContent = '';
        authTitle.innerHTML = `<i class="fas fa-user-lock"></i> ${authMode === 'login' ? 'Login' : 'Register'}`;
        authSubmitBtn.textContent = authMode === 'login' ? 'Sign in' : 'Create account';
        authToggle.textContent = authMode === 'login' ? 'Create an account' : 'Back to login';
      }
    }

    // ---------- event binding ----------
    document.getElementById('homeBtn').addEventListener('click', showHome);
    document.getElementById('cartBtn').addEventListener('click', showCart);
    document.getElementById('ordersBtn').addEventListener('click', showOrders);
    document.getElementById('authBtn').addEventListener('click', showAuth);
    logoutBtn.addEventListener('click', () => {
      currentUser = null;
      updateAuthUI();
      alert('Logged out.');
      showHome();
    });
    detailCloseBtn.addEventListener('click', closeDetail);
    detailAddBtn.addEventListener('click', () => {
      if (currentDetailProduct) {
        addToCart(currentDetailProduct.id);
        detailAddBtn.style.transform = 'scale(0.94)';
        setTimeout(() => detailAddBtn.style.transform = '', 200);
        alert('Added to cart!');
      }
    });
    checkoutBtn.addEventListener('click', placeOrder);
    authSubmitBtn.addEventListener('click', handleAuth);
    authToggle.addEventListener('click', () => {
      authMode = authMode === 'login' ? 'register' : 'login';
      authTitle.innerHTML = `<i class="fas fa-user-lock"></i> ${authMode === 'login' ? 'Login' : 'Register'}`;
      authSubmitBtn.textContent = authMode === 'login' ? 'Sign in' : 'Create account';
      authToggle.textContent = authMode === 'login' ? 'Create an account' : 'Back to login';
      authMessage.textContent = '';
    });

    // init
    renderProducts();
    updateCartUI();
    updateAuthUI();
    renderOrders();
    authEmail.value = 'demo@shop.com';
    authPassword.value = '123456';
  })();
</script>
</body>
</html>
